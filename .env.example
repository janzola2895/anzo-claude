# Optional. Copy to `.env` (git-ignored) to change a default. Read by server.py
# at startup, so it also applies when ANZO + Claude is opened by double-click.
# A variable set in the real environment still wins over this file.

# Claude model alias or id for every turn (empty = Claude Code's default).
ANZO_MODEL=
# Port of the local server (the original ANZO uses 8730).
ANZO_PORT=8740
# Chrome profile where the Claude in Chrome extension is installed.
ANZO_CHROME_PROFILE=Default
# Folder where ANZO saves screenshots and text files (default: Desktop\ANZO archivos).
ANZO_OUTPUT_DIR=
# Max tool calls in one turn before ANZO stops and asks whether to go on
# ("Anzo, sigue"). Guards against Claude looping on a step it can't do. 0 = no cap.
ANZO_MAX_TOOL_CALLS=60
