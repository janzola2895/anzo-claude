# Copy to `.env` (git-ignored) and fill in. Read by server.py at startup, so it
# also applies when ANZO is opened by double-click (a `set` in some terminal
# doesn't reach a launcher started from the desktop). A variable set in the
# real environment still wins over this file.

# claude-code-router: off | fallback | always | router_first
#   router_first = router (Gemini -> OVH...) first, Claude membership last
#   fallback     = Claude membership first, router when it runs out
ANZO_ROUTER=router_first
# Client key from the router's "API Keys" page (ccr ui -> API Keys).
ANZO_ROUTER_KEY=
# Optional: model as the router names it. Empty = let the router's rules decide.
ANZO_ROUTER_MODEL=
